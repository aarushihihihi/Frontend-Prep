<% layout("/layouts/boilerplate") %>
<body>

    <div class="row">

<div class="col-8 offset-2 mt-3">


    <h1>Listing Details :</h1>

        </div>

    <div class="card col-6 offset-3">
        <img src="<%=listing.image.url%>" alt="Listing_image" class="card-img-top show-img">
        <div class="card-body">

            <p class="card-text">
                <b>

<%=listing.title%>

</b>
            </p>


               <p class="card-text">
<%=listing.description%>            </p>




               <p class="card-text">
&#8377;<%= listing.price ? Number(listing.price).toLocaleString("en-IN") : "N/A" %>     </p>

            <p class="card-text">
<%=listing.location%>            </p>


        <p class="card-text">
<%=listing.country%>          </p>




        </div>
    </div>


    <div class="btns">


<form method="get" action="/listings/<%=listing.id%>/edit">


<button class="btn btn-dark mr-3 edit-btn">
    Edit
</button>
<br>
<br>
</form>


<form method="post" action="/listings/<%=listing.id%>?_method=delete" >

    <button class="btn btn-dark mr-3 delete-btn">Delete Listing</button>
</form>

    </div>


</body>
